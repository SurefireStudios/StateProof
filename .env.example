# StateProof environment template.
# Copy to .env and fill in locally. .env is git-ignored and is loaded
# automatically by the baseline and smoke-test commands.
#
# NOTE: no value below is required for `pnpm typecheck`, `pnpm test` or
# `pnpm benchmark:validate`. Those run fully offline.

# Required for `pnpm benchmark:smoke-model` and `pnpm benchmark:baseline`.
#
# This is deliberately NOT named ANTHROPIC_API_KEY. That variable belongs to
# your Claude Code session's own authentication, and StateProof never reads it.
STATEPROOF_ANTHROPIC_API_KEY=

# Optional model overrides. Whatever is set here is recorded verbatim in the
# run manifest, so a result can never be attributed to the wrong configuration.
# Defaults: claude-opus-5 / high / 16000 / 120000.
STATEPROOF_MODEL_ID=
STATEPROOF_MODEL_EFFORT=
STATEPROOF_MODEL_MAX_TOKENS=
STATEPROOF_MODEL_TIMEOUT_MS=

# Gate for the locked challenge split. Leave unset until the freeze point.
STATEPROOF_ALLOW_LOCKED_RUN=
