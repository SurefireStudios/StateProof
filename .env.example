# StateProof environment template.
# Copy to .env and fill in locally. Never commit a filled-in .env.
#
# NOTE (Foundation Gate): no key below is required yet. `pnpm typecheck`,
# `pnpm test` and `pnpm benchmark:validate` run fully offline.

# Model provider used by the (not yet implemented) baseline and StateProof agents.
ANTHROPIC_API_KEY=

# Model identifier recorded in every run manifest.
STATEPROOF_MODEL_ID=

# "replay" uses committed captured responses, "live" calls the provider.
# Only "replay" is meaningful until the agent runners exist.
STATEPROOF_RUN_MODE=replay
