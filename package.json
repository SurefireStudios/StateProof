{
  "name": "stateproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=8.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:validate": "tsx packages/benchmark/src/cli/validate.ts",
    "benchmark:validate-hard": "tsx packages/benchmark/src/cli/validate-hard.ts",
    "benchmark:smoke-model": "tsx packages/agents/src/cli/smoke-model.ts",
    "benchmark:baseline": "tsx packages/agents/src/cli/baseline.ts",
    "benchmark:baseline-hard": "tsx packages/agents/src/cli/baseline-hard.ts",
    "benchmark:stateproof-hard": "tsx packages/agents/src/cli/stateproof-hard.ts",
    "dashboard:build": "pnpm --filter dashboard build",
    "dev": "pnpm --filter dashboard dev",
    "reproduce": "tsx scripts/reproduce.ts",
    "reproduce:check": "tsx scripts/reproduce.ts --check-only",
    "submission:summary": "tsx scripts/generate-submission-summary.ts",
    "submission:manifest": "tsx scripts/generate-reproduction-manifest.ts",
    "compare:development": "tsx scripts/compare-development-runs.ts",
    "check:provenance": "tsx scripts/check-run-provenance.ts",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "fixtures:generate-hard": "tsx scripts/generate-hard-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "tsx": "4.19.2",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
