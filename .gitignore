# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# environment
.env
.env.*
!.env.example
# stray copies (e.g. Windows "Copy" duplicates) can contain a real key
.env*Copy*
*.env

# generated run output (artifacts are committed selectively, never automatically)
artifacts/tmp/
coverage/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local-only Claude Code settings (contains the .env read-deny rule)
.claude/settings.local.json

# local archives / backups
*.zip
# the sample run package is a deliverable: a judge imports it from the product
!samples/*.zip

# local working notes: supplied briefs, gate prompts and audit addenda.
# These are planning documents, not deliverables, and are not published.
# CLAUDE.md is deliberately NOT ignored: it is the repository instruction file.
0[0-9]_*.md
CLAUDE_*.md
apps/dashboard/dist/

# release packages are build output, not source. Tracking the contents note or
# the hash would be circular: both describe an archive whose bytes include them.
# `submission/final-package-manifest.json` is the tracked record, and it names
# the commit its archive was built from.
release/
apps/product/dist/

# a loose copy of the mark dropped at the root; the tracked copies that actually
# ship are apps/product/src/client/logo.svg and apps/dashboard/src/logo.svg
/Surefire-Icon.svg
dist-server/
