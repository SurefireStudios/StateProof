# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# environment
.env
.env.*
!.env.example
# stray copies (e.g. Windows "Copy" duplicates) can contain a real key
.env*Copy*
*.env

# generated run output (artifacts are committed selectively, never automatically)
artifacts/tmp/
coverage/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local-only Claude Code settings (contains the .env read-deny rule)
.claude/settings.local.json

# local archives / backups
*.zip
