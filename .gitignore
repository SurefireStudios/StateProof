# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# environment
.env
.env.*
!.env.example
# stray copies (e.g. Windows "Copy" duplicates) can contain a real key
.env*Copy*
*.env

# generated run output (artifacts are committed selectively, never automatically)
artifacts/tmp/
coverage/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local-only Claude Code settings (contains the .env read-deny rule)
.claude/settings.local.json

# local archives / backups
*.zip

# local working notes: supplied briefs, gate prompts and audit addenda.
# These are planning documents, not deliverables, and are not published.
# CLAUDE.md is deliberately NOT ignored: it is the repository instruction file.
0[0-9]_*.md
CLAUDE_*.md
apps/dashboard/dist/

# release packages are built artifacts, not source
release/
